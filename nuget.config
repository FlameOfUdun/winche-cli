<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Winche packages built locally, before they're on nuget.org (empty otherwise). -->
    <add key="local" value="packages" />
  </packageSources>
</configuration>
