<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Winche.Cli</RootNamespace>
    <AssemblyName>winche</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>winche</ToolCommandName>
    <PackageId>Winche.Cli</PackageId>
    <PackageDescription>The winche command-line tool: set up and use a Winche Server from the terminal, test access rules locally, and deploy rules, indexes, settings and functions. Install with: dotnet tool install -g Winche.Cli</PackageDescription>
    <PackageTags>winche;cli;rules;security-rules;deploy</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Winche.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- winche emulators: the database, storage and console in one local process. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Winche.Rules" Version="5.0.0" />
    <PackageReference Include="Winche.Database.AspNetCore.Rest" Version="12.1.0" />
    <PackageReference Include="Winche.Database.AspNetCore.WebSockets" Version="12.1.0" />
    <PackageReference Include="Winche.Storage.AspNetCore.Rest" Version="11.2.0" />
    <PackageReference Include="Winche.Storage.FileSystem" Version="11.2.0" />
    <PackageReference Include="Winche.Storage.S3" Version="11.2.0" />
    <PackageReference Include="Winche.Functions.Database" Version="3.3.1" />
    <PackageReference Include="Winche.Functions.Storage" Version="3.3.1" />
    <PackageReference Include="Winche.Functions.Auth" Version="3.3.1" />
    <PackageReference Include="Winche.Assets.AspNetCore" Version="1.1.0" />
    <PackageReference Include="Winche.Functions.Assets" Version="3.3.1" />
    <PackageReference Include="Winche.Functions.Realtime" Version="3.3.1" />
    <PackageReference Include="Winche.Realtime.AspNetCore" Version="1.0.1" />
    <PackageReference Include="Winche.Auth.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Winche.Core" Version="2.0.0" />
    <PackageReference Include="Winche.Core.AspNetCore" Version="2.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <!-- Testcontainers brings SSH.NET 2025.1.0, which has known vulnerabilities; the fixed release. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- Its rule value comparer, so `rules test` compares values exactly as the database does. -->
    <PackageReference Include="Winche.Database" Version="12.1.0" />
  </ItemGroup>
</Project>
